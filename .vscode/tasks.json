{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "uniauth:classes",
      "type": "shell",
      "command": "./gradlew --offline --console plain :apps:uniauth:backend:classes",
      "windows": {
        "command": ".\\gradlew.bat --offline --console plain :apps:uniauth:backend:classes"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$javac"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "uniauth:run",
      "type": "shell",
      "command": "./gradlew --offline --console plain :apps:uniauth:backend:run",
      "windows": {
        "command": ".\\gradlew.bat --offline --console plain :apps:uniauth:backend:run"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "rule-engine:run",
      "type": "shell",
      "command": "python3 apps/rule-engine/backend/src/main/python/com/sp/selplat/local/code/XUNAN/abilities/rule_engine_backend.py",
      "windows": {
        "command": "py -3 apps/rule-engine/backend/src/main/python/com/sp/selplat/local/code/XUNAN/abilities/rule_engine_backend.py"
      },
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONUTF8": "1",
          "PYTHONIOENCODING": "utf-8",
          "PYTHONPYCACHEPREFIX": "${workspaceFolder}/cache/python-pycache"
        }
      },
      "problemMatcher": []
    }
  ]
}
