{
  "java.import.gradle.user.home": "C:/opt/workspace/SELPLAT/cache/gradle-user-home",
  "java.autobuild.enabled": false, 
  "java.configuration.updateBuildConfiguration": "automatic",
  "java.import.gradle.wrapper.enabled": true,
  "java.import.gradle.offline.enabled": true,
  "java.gradle.buildServer.enabled": "off",
  "java.jdt.ls.lombokSupport.enabled": true,
  "java.import.exclusions": [
    "**/bin/**"
  ],
  "java.debug.settings.forceBuildBeforeLaunch": true,
  "java.debug.settings.onBuildFailureProceed": false,
  "files.exclude": {
    "**/bin": true,
    "build": true,
    "cache": true,
    ".codex": true,
    ".agents": true
  },
  "search.exclude": {
    "**/bin": true,
    "**/build": true,
    "cache": true
  },
  "[java]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "terminal.integrated.env.osx": {
    "PYTHONUTF8": "1",
    "PYTHONIOENCODING": "utf-8",
    "PYTHONPYCACHEPREFIX": "${workspaceFolder}/cache/python-pycache"
  },
  "java.compile.nullAnalysis.mode": "disabled"
}
