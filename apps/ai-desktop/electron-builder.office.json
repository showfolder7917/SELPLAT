{
  "appId": "com.selplat.aidesktop.office",
  "productName": "AI Desktop Office",
  "directories": { "output": "release/office" },
  "files": ["dist/client/**/*", "dist/developer/**/*", "dist-electron/**/*", "package.json"],
  "asarUnpack": ["node_modules/@openai/codex/**/*", "node_modules/@openai/codex-*/**/*"],
  "win": { "target": "nsis", "artifactName": "AI-Desktop-Office-${version}-Setup.${ext}" },
  "mac": { "target": "dmg", "artifactName": "AI-Desktop-Office-${version}.${ext}", "category": "public.app-category.productivity" }
}
