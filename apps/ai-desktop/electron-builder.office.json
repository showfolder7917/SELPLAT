{
  "appId": "com.selplat.aidesktop.office",
  "productName": "AI Desktop Office",
  "extraMetadata": { "aiDesktopVariant": "office", "main": "dist-electron/electron/main.js" },
  "directories": { "output": "../../build/ai-desktop/package/office" },
  "files": [
    { "from": "../../build/ai-desktop/sites/client", "to": "dist/client", "filter": ["**/*"] },
    { "from": "../../build/ai-desktop/electron", "to": "dist-electron", "filter": ["**/*"] },
    "package.json",
    "!node_modules/@selplat/node-common-core/**/*.map",
    "!node_modules/@selplat/node-common-core/**/*.d.ts",
    "!node_modules/@selplat/node-common-core/{src,tests}/**/*"
  ],
  "asarUnpack": ["node_modules/@openai/codex/**/*", "node_modules/@openai/codex-*/**/*"],
  "win": { "target": "nsis", "artifactName": "AI-Desktop-Office-${version}-Setup.${ext}" },
  "mac": { "target": "dmg", "artifactName": "AI-Desktop-Office-${version}.${ext}", "category": "public.app-category.productivity" }
}
