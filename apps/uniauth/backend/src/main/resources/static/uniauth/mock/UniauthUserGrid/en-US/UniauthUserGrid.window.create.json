{
  "title": "Create Project",
  "subtitle": "Create a new project and set its basic information",
  "closeLabel": "Close create project window",
  "cancelLabel": "Cancel",
  "submitLabel": "Create Now",
  "checkboxLabel": "Add tasks immediately after creation",
  "validationMessage": "Enter a project name and complete all required selections",
