{
  "read_file": {
    "path": "./skill/read_file.py",
    "summary": "读取 UTF-8 文本文件内容",
    "inputs": ["file_path"],
    "outputs": ["content"]
  },
  "read_ai_memory_file": {
    "path": "./skill/read_ai_memory_file.py",
    "summary": "读取 MEMORIES/ai 目录文件，并输出去注释去空行后的稳定文本",
    "inputs": ["file_path"],
    "outputs": ["source_path", "cleaned_content", "line_count"]
  },
  "read_memory_file_full": {
    "path": "./skill/read_memory_file_full.py",
    "summary": "读取工程目录文件，并返回完整原文",
    "inputs": ["file_path"],
    "outputs": ["source_path", "content", "line_count"]
  },
  "write_file": {
    "path": "./skill/write_file.py",
    "summary": "将文本写入 UTF-8 文件",
    "inputs": ["file_path", "content"],
    "outputs": ["written"]
  },
  "run_pytest": {
    "path": "./skill/run_pytest.py",
    "summary": "运行 pytest 并返回结果",
    "inputs": ["target"],
    "outputs": ["returncode", "stdout", "stderr"]
  },
  "fix_small_bug": {
    "path": "./skill/fix_small_bug.py",
    "summary": "处理已有定位信息的小范围问题修复",
    "inputs": ["target_file", "bug_summary"],
    "outputs": ["status", "next_action"]
  },
  "ffmpeg_vob_to_mp4": {
    "path": "./skill/ffmpeg_vob_to_mp4.py",
    "summary": "调用 ffmpeg 对 VOB 执行去隔行、裁黑边、高质量缩放并输出 MP4",
    "inputs": ["input_file", "output_file"],
    "outputs": ["returncode", "stdout", "stderr", "output_file", "duration_seconds", "crop_filter", "video_check"]
  },
  "ffmpeg_vob_to_mp3": {
    "path": "./skill/ffmpeg_vob_to_mp3.py",
    "summary": "调用 ffmpeg 将 VOB 中的音频提取并输出为 MP3",
    "inputs": ["input_file", "output_file"],
    "outputs": ["returncode", "stdout", "stderr", "output_file", "duration_seconds", "video_check"]
  },
  "ffmpeg_mp4_to_wav": {
    "path": "./skill/ffmpeg_mp4_to_wav.py",
    "summary": "调用 ffmpeg 将 MP4 中的音频提取并输出为 WAV",
    "inputs": ["input_file", "output_file"],
    "outputs": ["returncode", "stdout", "stderr", "output_file", "duration_seconds", "video_check"]
  },
  "launch_gui_app_with_plan": {
    "path": "./skill/launch_gui_app_with_plan.py",
    "summary": "启动已登记 GUI 应用，并传入标准化自动化计划上下文",
    "inputs": ["app_id", "app_config", "app_context"],
    "outputs": ["status", "app", "python_bin", "pid", "context"]
  }
}
